{
  "name": "keel",
  "version": "0.0.0",
  "private": true,
  "description": "Agent-native durable execution engine for TypeScript (working name)",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --test-timeout=20000 --test-global-setup=test/helpers/global-setup.ts 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
