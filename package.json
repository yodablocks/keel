{
  "name": "keel",
  "version": "0.0.0",
  "private": true,
  "description": "Agent-native durable execution engine for TypeScript (working name)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "db/migrations",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --test-timeout=20000 --test-global-setup=test/helpers/global-setup.ts 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "eval:classifier": "node --env-file-if-exists=.env scripts/eval-classifier.ts",
    "demo": "node --env-file-if-exists=.env scripts/demo.ts",
    "bench:deferred": "node --env-file-if-exists=.env scripts/bench-deferred.ts",
    "eval:export": "node --env-file-if-exists=.env scripts/eval-export.ts",
    "dashboard": "node --env-file-if-exists=.env scripts/dashboard.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "typescript": "^7.0.2"
  }
}
